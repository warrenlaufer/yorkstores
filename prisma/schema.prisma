generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  BUYER
  STORE_OWNER
  ADMIN
}

enum OrderStatus {
  PENDING
  SHIPPED
  DELIVERED
}

enum OutcomeType {
  DELIVERY
  SOLD_BACK
  AUTO_SOLD
  AUTO_FAILED
}

enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  role              Role      @default(BUYER)
  passwordHash      String
  company           String?
  walletBalance     Decimal   @default(0.00) @db.Decimal(10, 2)
  cashBalance       Decimal   @default(0.00) @db.Decimal(10, 2)
  promoBalance      Decimal   @default(0.00) @db.Decimal(10, 2)
  storeBalance      Decimal   @default(0.00) @db.Decimal(10, 2)
  stripeCustomerId  String?   @unique
  stripeAccountId   String?   @unique
  payoutsEnabled    Boolean   @default(false)
  agreementVersion          String?
  agreementAcceptedAt       DateTime?
  sellerAgreementVersion    String?
  sellerAgreementAcceptedAt DateTime?
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  emailVerified     Boolean   @default(false)
  verifyToken       String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions          Session[]
  drops             Drop[]
  purchases         Purchase[]
  orders            Order[]
  transactions      Transaction[]
  walletTopups      WalletTopup[]
  withdrawals       Withdrawal[]
  promoRedemptions  PromoRedemption[]
  storeTheme        StoreTheme?
  agreementAcceptances AgreementAcceptance[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Drop {
  id          String   @id @default(cuid())
  name        String
  emoji       String   @default("🎁")
  logoUrl     String?
  sellBackPct Int      @default(90)
  pricingType String   @default("fixed")
  category    String   @default("Other Collectibles")
  subcategory String?
  ownerId     String
  isActive    Boolean  @default(true)
  isDraft     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner                User                   @relation(fields: [ownerId], references: [id])
  boxes                Box[]
  orders               Order[]
  transactions         Transaction[]
  platformTransactions PlatformTransaction[]
  purchases            Purchase[]
}

model Box {
  id               String    @id @default(cuid())
  dropId           String
  itemName         String
  itemPrice        Decimal   @db.Decimal(10, 2)
  itemShippingCost Decimal   @default(0) @db.Decimal(10, 2)
  itemImageUrl     String?
  useUscApi        Boolean   @default(false)
  sku              String?
  sold             Boolean   @default(false)
  createdAt        DateTime  @default(now())

  drop      Drop      @relation(fields: [dropId], references: [id], onDelete: Cascade)
  purchases Purchase[]
}

model Purchase {
  id          String      @id @default(cuid())
  buyerId     String
  boxId       String
  dropId      String
  pricePaid   Decimal     @db.Decimal(10, 2)
  promoPaid   Decimal     @default(0) @db.Decimal(10, 2)
  cashPaid    Decimal     @default(0) @db.Decimal(10, 2)
  reservedAmt Decimal     @default(0) @db.Decimal(10, 2)
  outcome     OutcomeType?
  refundAmt   Decimal     @default(0) @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  revealedAt  DateTime?
  resolvedAt  DateTime?

  itemName         String?
  itemPrice        Decimal? @db.Decimal(10, 2)
  itemShippingCost Decimal? @db.Decimal(10, 2)
  itemImageUrl     String?

  buyer       User        @relation(fields: [buyerId], references: [id])
  box         Box         @relation(fields: [boxId], references: [id])
  drop        Drop        @relation(fields: [dropId], references: [id])
  order       Order?
}

model Order {
  id              String      @id @default(cuid())
  purchaseId      String      @unique
  dropId          String
  buyerId         String
  status          OrderStatus @default(PENDING)
  recipientName   String
  recipientEmail  String
  addressLine1    String
  addressLine2    String?
  city            String
  state           String?
  postcode        String
  country         String      @default("United States")
  trackingNumber  String?
  taxPaid         Decimal     @default(0) @db.Decimal(10, 2)
  stripeTaxTransactionId String?
  shippedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  purchase        Purchase    @relation(fields: [purchaseId], references: [id])
  drop            Drop        @relation(fields: [dropId], references: [id])
  buyer           User        @relation(fields: [buyerId], references: [id])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  dropId      String?
  type        String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  drop        Drop?    @relation(fields: [dropId], references: [id])
}

model PlatformTransaction {
  id          String   @id @default(cuid())
  type        String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  dropId      String?
  createdAt   DateTime @default(now())

  drop        Drop?    @relation(fields: [dropId], references: [id])
}

model WalletTopup {
  id                    String   @id @default(cuid())
  userId                String
  amount                Decimal  @db.Decimal(10, 2)
  stripePaymentIntentId String   @unique
  status                String   @default("pending")
  createdAt             DateTime @default(now())

  user                  User     @relation(fields: [userId], references: [id])
}

model Withdrawal {
  id          String           @id @default(cuid())
  userId      String
  source      String           // 'buyer' (cashBalance) or 'store' (storeBalance)
  amount      Decimal          @db.Decimal(10, 2)
  status      WithdrawalStatus @default(PENDING)
  note        String?
  stripeTransferId String?
  forfeitedPromo Decimal     @default(0) @db.Decimal(10, 2)
  createdAt   DateTime         @default(now())
  processedAt DateTime?

  user        User             @relation(fields: [userId], references: [id])
}

model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String   @default("fixed")
  amount      Decimal  @db.Decimal(10, 2)
  matchPct    Int      @default(100)
  description String?
  maxUses     Int?
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  userId      String
  createdAt   DateTime  @default(now())

  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([promoCodeId, userId])
}

model StoreTheme {
  id              String   @id @default(cuid())
  userId          String   @unique
  primaryColor    String   @default("#FF6B85")
  backgroundColor String   @default("#08080B")
  cardColor       String   @default("#0F0F14")
  textColor       String   @default("#EEEEF5")
  accentColor     String   @default("#F5C842")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model AgreementAcceptance {
  id         String   @id @default(cuid())
  userId     String
  kind       String   // 'general' (terms + privacy) or 'seller'
  version    String
  acceptedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
