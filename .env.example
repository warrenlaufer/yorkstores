# Database (Supabase, PlanetScale, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/yorkstores"

# Auth
JWT_SECRET="generate-a-long-random-secret-here-min-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# For store owner payouts via Stripe Connect
STRIPE_CONNECT_CLIENT_ID="ca_..."

# Resend (email)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yorkstores.com"

# Cloudflare R2 (image uploads)
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="yorkstores-images"
R2_PUBLIC_URL="https://images.yorkstores.com"

# Admin
ADMIN_EMAIL="admin@yorkstores.com"
